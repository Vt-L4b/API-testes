# Copie para .env e preencha. NUNCA versione o .env.

# Token mestre para gerar/revogar chaves (rotas /admin). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=troque-por-um-token-forte

# Banco onde ficam as chaves (SQLite local)
DATABASE_URL=sqlite:///./data.db

# Chaves de acesso fixas (separadas por vírgula), além das geradas em /admin/keys.
# No Render, coloque aqui a chave da Whizz: o banco é apagado a cada reinício.
API_KEYS=

# Arquivo com a lista de produtos servida pela API
PRODUCTS_FILE=produtos.json
